{
  "file": "C:\\Users\\wodus\\ai-workspace\\RisuToki\\risu\\bot\\거대녀 하숙집\\거대녀 하숙집.charx",
  "allow_writes": false,
  "tool_profile": "advanced-full",
  "output_path": ".tmp/inspect-charx-output.json",
  "steps": [
    {
      "id": "inspect",
      "tool": "inspect_document",
      "args": {
        "target": {
          "kind": "active"
        },
        "max_bytes": 32000
      }
    },
    {
      "id": "fields",
      "tool": "read_content",
      "args": {
        "target": {
          "kind": "active"
        },
        "selectors": [
          {
            "family": "field",
            "field": "name"
          },
          {
            "family": "field",
            "field": "description"
          },
          {
            "family": "field",
            "field": "firstMessage"
          },
          {
            "family": "field",
            "field": "globalNote"
          },
          {
            "family": "field",
            "field": "creatorcomment"
          }
        ],
        "max_bytes": 64000
      }
    },
    {
      "id": "lorebook",
      "tool": "read_content",
      "args": {
        "target": {
          "kind": "active"
        },
        "selectors": [
          {
            "family": "lorebook"
          }
        ],
        "max_bytes": 64000
      }
    },
    {
      "id": "korean_scan",
      "tool": "search_all_fields",
      "args": {
        "query": "[가-힣ㄱ-ㅎㅏ-ㅣ]+",
        "regex": true,
        "flags": "g",
        "include_lorebook": true,
        "include_greetings": true,
        "context_chars": 180,
        "max_matches_per_field": 20
      }
    }
  ]
}
