{
  "file": "C:\\Users\\wodus\\ai-workspace\\RisuToki\\risu\\bot\\거대녀 하숙집\\거대녀 하숙집.charx",
  "allow_writes": false,
  "tool_profile": "advanced-full",
  "output_path": ".tmp/validate-charx-output.json",
  "steps": [
    {
      "id": "inspect",
      "tool": "inspect_document",
      "args": {
        "target": {
          "kind": "active"
        },
        "max_bytes": 32000
      }
    },
    {
      "id": "fields",
      "tool": "read_content",
      "args": {
        "target": {
          "kind": "active"
        },
        "selectors": [
          {
            "family": "field",
            "field": "name"
          },
          {
            "family": "field",
            "field": "description"
          },
          {
            "family": "field",
            "field": "creatorcomment"
          },
          {
            "family": "field",
            "field": "creator"
          },
          {
            "family": "surface",
            "path": "/_moduleData/module/name",
            "include_raw": true
          }
        ],
        "max_bytes": 65536
      }
    },
    {
      "id": "lorebook",
      "tool": "read_content",
      "args": {
        "target": {
          "kind": "active"
        },
        "selectors": [
          {
            "family": "lorebook"
          }
        ],
        "max_bytes": 65536
      }
    },
    {
      "id": "key_validation",
      "tool": "validate_lorebook_keys",
      "args": {}
    },
    {
      "id": "export_validation",
      "tool": "validate_content",
      "args": {
        "target": {
          "kind": "active"
        },
        "selectors": [
          {
            "family": "asset",
            "field": "exportCompatibility"
          }
        ],
        "max_bytes": 65536
      }
    },
    {
      "id": "korean_scan",
      "tool": "search_all_fields",
      "args": {
        "query": "[가-힣ㄱ-ㅎㅏ-ㅣ]+",
        "regex": true,
        "flags": "g",
        "include_lorebook": true,
        "include_greetings": true,
        "context_chars": 180,
        "max_matches_per_field": 20
      }
    }
  ]
}
