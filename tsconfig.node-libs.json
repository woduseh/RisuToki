{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "strict": true,
    "rootDir": ".",
    "outDir": ".build/node",
    "incremental": true,
    "tsBuildInfoFile": ".build/node/node-libs.tsbuildinfo",
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": [
    "src/adm-zip.d.ts",
    "src/css-inline.d.ts",
    "src/lib/skill-link-sync.ts",
    "toki-mcp-server.ts",
    "test/test-rpack.ts",
    "test/test-charx.ts",
    "test/test-reference-store.ts",
    "test/test-terminal-shell.ts",
    "test/test-main-state-store.ts",
    "test/test-mcp-search-all.ts",
    "test/mcp-contract-baseline.ts",
    "test/run-workflow-eval-replay.ts"
  ],
  "exclude": [".build", "dist", "node_modules"]
}
