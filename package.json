{
  "name": "risutoki",
  "version": "3.5.0",
  "description": "Desktop editor and MCP workspace for RisuAI .charx, .risum, and .risup artifacts",
  "main": ".build/electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "dev:electron": "wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .",
    "dev:build": "npm run build:electron && npm run dev",
    "start:build": "npm run build:electron && npm run build:renderer && npm start",
    "start": "electron .",
    "lint": "npx eslint \"src/**/*.{ts,vue}\" \"test/**/*.ts\" \"build/**/*.js\" main.ts preload.ts vite.config.ts vitest.setup.ts toki-mcp-server.ts --max-warnings=0",
    "typecheck": "vue-tsc --noEmit && tsc -p tsconfig.electron.json --noEmit && tsc -p tsconfig.node-libs.json --noEmit",
    "build:node-libs": "node build/clean-output.js node && tsc -p tsconfig.node-libs.json",
    "sync:skills": "npm run build:node-libs && node .build/node/src/lib/skill-link-sync.js",
    "build:mcp": "node build/build-mcp.js",
    "mcp:standalone": "npm run build:mcp && node toki-mcp-server.js --standalone",
    "build:preload": "node build/build-preload.js",
    "test-rpack": "node .build/node/test/test-rpack.js",
    "test-charx": "node .build/node/test/test-charx.js",
    "test:references": "node .build/node/test/test-reference-store.js && node .build/node/test/test-terminal-shell.js && node .build/node/test/test-main-state-store.js",
    "test:unit": "vitest run",
    "test:corpus": "cross-env RISUTOKI_TEST_LOCAL_CORPUS=1 npm run test:evals && cross-env RISUTOKI_TEST_LOCAL_CORPUS=1 npm run test:mcp",
    "test:evals": "vitest run src/lib/mcp-agent-workflow-eval.test.ts src/lib/creative-skill-routing-eval.test.ts src/lib/mcp-response-envelope.test.ts src/lib/mcp-tool-taxonomy.test.ts src/lib/mcp-runtime-contract.test.ts src/lib/section-parser.test.ts src/lib/mcp-api-server.test.ts src/lib/mcp-risup-prompt-routes.test.ts --reporter=verbose -t \"agent eval\"",
    "test:evals:replay": "npm run build:node-libs && npm run build:mcp && node .build/node/test/run-workflow-eval-replay.js",
    "test:mcp:contracts": "npm run build:node-libs && npm run build:mcp && node .build/node/test/mcp-contract-baseline.js",
    "test:mcp:contracts:update": "npm run build:node-libs && npm run build:mcp && node .build/node/test/mcp-contract-baseline.js --update",
    "test:mcp": "npm run build:node-libs && npm run build:mcp && node .build/node/test/test-mcp-search-all.js",
    "test": "node build/validate.js --profile test",
    "build:electron": "npm run build:node-libs && npm run build:mcp && node build/clean-output.js electron && tsc -p tsconfig.electron.json && npm run build:preload",
    "build:renderer": "vite build",
    "build": "node build/validate.js --profile full",
    "dist": "npm run build:electron && npm run build:renderer && electron-builder",
    "dist:portable": "npm run build:electron && npm run build:renderer && electron-builder --win portable",
    "dist:installer": "npm run build:electron && npm run build:renderer && electron-builder --win nsis",
    "dist:all": "npm run build:electron && npm run build:renderer && electron-builder --win nsis portable",
    "prepare": "npm run sync:skills && husky",
    "validate": "node build/validate.js",
    "validate:ci": "node build/validate.js --profile ci",
    "validate:full": "node build/validate.js --profile full",
    "test:tooling": "node --test build/validation-plan.test.js build/validate.test.js"
  },
  "lint-staged": {
    "*.{ts,vue}": [
      "eslint --max-warnings=0"
    ],
    "*.{ts,vue,json,md,css}": [
      "prettier --write"
    ],
    "build/**/*.js": [
      "eslint --max-warnings=0"
    ]
  },
  "dependencies": {
    "@dqbd/tiktoken": "^1.0.22",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@tabler/icons-vue": "^3.45.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "adm-zip": "^0.6.0",
    "dompurify": "^3.4.12",
    "electron-updater": "^6.8.9",
    "highlight.js": "^11.11.1",
    "katex": "^0.16.47",
    "markdown-it": "^14.3.0",
    "marked": "^12.0.2",
    "monaco-editor": "0.53.0",
    "msgpackr": "^1.11.8",
    "node-pty": "^1.1.0",
    "pinia": "^3.0.4",
    "postcss": "^8.5.23",
    "postcss-selector-parser": "^7.1.4",
    "sharp": "^0.35.3",
    "sortablejs": "^1.15.7",
    "vue": "^3.5.29",
    "wasmoon": "^1.16.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@msgpack/msgpack": "^3.1.3",
    "@types/markdown-it": "^14.1.2",
    "@types/sortablejs": "^1.15.9",
    "@vitejs/plugin-vue": "^6.0.4",
    "@vue/test-utils": "^2.4.6",
    "concurrently": "^9.2.4",
    "cross-env": "^10.1.0",
    "electron": "^40.10.6",
    "electron-builder": "^26.15.3",
    "eslint": "^10.0.3",
    "eslint-plugin-vue": "^10.8.0",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "jsdom": "^28.1.0",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^7.3.6",
    "vite-plugin-static-copy": "^3.2.0",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.2.5",
    "wait-on": "^9.0.4"
  },
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "overrides": {
    "@hono/node-server": "2.0.12",
    "brace-expansion": "5.0.8"
  },
  "author": "toki",
  "build": {
    "appId": "com.risutoki.editor",
    "productName": "RisuToki",
    "publish": [
      {
        "provider": "github",
        "owner": "woduseh",
        "repo": "RisuToki"
      }
    ],
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.ico",
      "signAndEditExecutable": true
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "installerHeader": "build/installerHeader.bmp",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/installerSidebar.bmp",
      "include": "build/installer.nsh",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "RisuToki",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "RisuToki-${version}-portable.exe"
    },
    "files": [
      "dist/**/*",
      ".build/electron/**/*",
      "toki-mcp-server.js",
      "tiktoken_bg.wasm",
      "glue.wasm",
      "src/rpack_map.bin",
      "assets/**/*",
      "guides/**/*",
      "resources/**/*",
      "skills/**/*",
      "risu/common/AGENTS.md",
      "risu/common/README.md",
      "risu/common/docs/**/*",
      "risu/common/skills/**/*",
      "risu/bot/AGENTS.md",
      "risu/bot/README.md",
      "risu/bot/docs/**/*",
      "risu/bot/skills/**/*",
      "risu/prompts/AGENTS.md",
      "risu/prompts/README.md",
      "risu/prompts/docs/**/*",
      "risu/prompts/skills/**/*",
      "risu/modules/AGENTS.md",
      "risu/modules/README.md",
      "risu/modules/docs/**/*",
      "risu/modules/skills/**/*",
      "risu/plugins/AGENTS.md",
      "risu/plugins/README.md",
      "risu/plugins/docs/**/*",
      "risu/plugins/skills/**/*",
      "node_modules/**/*"
    ],
    "asarUnpack": [
      "toki-mcp-server.js",
      "tiktoken_bg.wasm",
      "glue.wasm",
      "node_modules/node-pty/**/*",
      "node_modules/sharp/**/*",
      "assets/persona/**/*",
      "resources/**/*"
    ],
    "extraResources": [
      {
        "from": "guides",
        "to": "guides"
      },
      {
        "from": "skills",
        "to": "skills"
      },
      {
        "from": "risu",
        "to": "risu",
        "filter": [
          "common/README.md",
          "common/docs/**/*",
          "common/skills/**/*",
          "bot/AGENTS.md",
          "bot/README.md",
          "bot/docs/**/*",
          "bot/skills/**/*",
          "prompts/AGENTS.md",
          "prompts/README.md",
          "prompts/docs/**/*",
          "prompts/skills/**/*",
          "modules/AGENTS.md",
          "modules/README.md",
          "modules/docs/**/*",
          "modules/skills/**/*",
          "plugins/AGENTS.md",
          "plugins/README.md",
          "plugins/docs/**/*",
          "plugins/skills/**/*"
        ]
      }
    ]
  }
}
