{
  "name": "risutoki",
  "version": "1.12.1",
  "description": "RisuAI .charx file editor with integrated terminal and MomoTalk UI",
  "main": "main.js",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "dev:electron": "wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .",
    "dev:build": "npm run build:electron && npm run dev",
    "start:build": "npm run build:electron && npm run build:renderer && npm start",
    "start": "electron .",
    "lint": "npx eslint \"src/**/*.{ts,vue}\" \"test/**/*.ts\" main.ts preload.ts popout-preload.ts vite.config.ts vitest.setup.ts toki-mcp-server.ts --max-warnings=0",
    "typecheck": "vue-tsc --noEmit && tsc -p tsconfig.electron.json --noEmit && tsc -p tsconfig.node-libs.json --noEmit",
    "build:node-libs": "tsc -p tsconfig.node-libs.json",
    "sync:skills": "npm run build:node-libs && node src/lib/skill-link-sync.js",
    "build:mcp": "node build/build-mcp.js",
    "mcp:standalone": "npm run build:mcp && node toki-mcp-server.js --standalone",
    "build:preload": "esbuild preload.ts --bundle --platform=node --format=cjs --outfile=preload.js --external:electron --target=node20 && esbuild popout-preload.ts --bundle --platform=node --format=cjs --outfile=popout-preload.js --external:electron --target=node20",
    "test-rpack": "node test/test-rpack.js",
    "test-charx": "node test/test-charx.js",
    "test:references": "node test/test-reference-store.js && node test/test-refs-popout-data.js && node test/test-popout-payload-store.js && node test/test-terminal-shell.js && node test/test-main-state-store.js",
    "test:unit": "vitest run",
    "test:evals": "vitest run src/lib/mcp-agent-workflow-eval.test.ts src/lib/creative-skill-routing-eval.test.ts src/lib/mcp-response-envelope.test.ts src/lib/mcp-tool-taxonomy.test.ts src/lib/mcp-runtime-contract.test.ts src/lib/section-parser.test.ts src/lib/mcp-api-server.test.ts --reporter=verbose -t \"agent eval\"",
    "test:evals:replay": "npm run build:node-libs && npm run build:mcp && node test/run-workflow-eval-replay.js",
    "test:mcp:contracts": "npm run build:node-libs && npm run build:mcp && node test/mcp-contract-baseline.js",
    "test:mcp": "npm run build:node-libs && npm run build:mcp && node test/test-mcp-search-all.js",
    "test": "npm run build:node-libs && npm run test-rpack && npm run test-charx && npm run test:references && npm run test:unit && npm run test:mcp",
    "build:electron": "npm run build:node-libs && npm run build:mcp && tsc -p tsconfig.electron.json && npm run build:preload",
    "build:renderer": "vite build",
    "build": "npm run lint && npm run typecheck && npm run test && npm run build:electron && npm run build:renderer",
    "dist": "npm run build:electron && npm run build:renderer && electron-builder",
    "dist:portable": "npm run build:electron && npm run build:renderer && electron-builder --win portable",
    "dist:installer": "npm run build:electron && npm run build:renderer && electron-builder --win nsis",
    "dist:all": "npm run build:electron && npm run build:renderer && electron-builder --win nsis portable",
    "prepare": "npm run sync:skills && husky"
  },
  "lint-staged": {
    "*.{ts,vue}": [
      "eslint --max-warnings=0"
    ],
    "*.{ts,vue,json,md,css}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@dqbd/tiktoken": "^1.0.22",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "adm-zip": "^0.5.16",
    "marked": "^12.0.2",
    "monaco-editor": "0.53.0",
    "msgpackr": "^1.11.8",
    "node-pty": "^1.1.0",
    "pinia": "^3.0.4",
    "sharp": "^0.34.5",
    "sortablejs": "^1.15.7",
    "vue": "^3.5.29",
    "wasmoon": "^1.16.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@msgpack/msgpack": "^3.1.3",
    "@types/sortablejs": "^1.15.9",
    "@vitejs/plugin-vue": "^6.0.4",
    "@vue/test-utils": "^2.4.6",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^40.8.0",
    "electron-builder": "^26.8.1",
    "eslint": "^10.0.3",
    "eslint-plugin-vue": "^10.8.0",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "jsdom": "^28.1.0",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^7.3.1",
    "vite-plugin-static-copy": "^3.2.0",
    "vitest": "^4.0.18",
    "vue-tsc": "^3.2.5",
    "wait-on": "^9.0.4"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "author": "toki",
  "build": {
    "appId": "com.risutoki.editor",
    "productName": "RisuToki",
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.ico",
      "signAndEditExecutable": true
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "installerHeader": "build/installerHeader.bmp",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/installerSidebar.bmp",
      "include": "build/installer.nsh",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "RisuToki"
    },
    "portable": {
      "artifactName": "RisuToki-${version}-portable.exe"
    },
    "files": [
      "dist/**/*",
      "main.js",
      "preload.js",
      "popout-preload.js",
      "toki-mcp-server.js",
      "tiktoken_bg.wasm",
      "glue.wasm",
      "src/**/*",
      "assets/**/*",
      "guides/**/*",
      "resources/**/*",
      "skills/**/*",
      "risu/common/AGENTS.md",
      "risu/common/README.md",
      "risu/common/docs/**/*",
      "risu/common/skills/**/*",
      "risu/bot/AGENTS.md",
      "risu/bot/README.md",
      "risu/bot/docs/**/*",
      "risu/bot/skills/**/*",
      "risu/prompts/AGENTS.md",
      "risu/prompts/README.md",
      "risu/prompts/docs/**/*",
      "risu/prompts/skills/**/*",
      "risu/modules/AGENTS.md",
      "risu/modules/README.md",
      "risu/modules/docs/**/*",
      "risu/modules/skills/**/*",
      "risu/plugins/AGENTS.md",
      "risu/plugins/README.md",
      "risu/plugins/docs/**/*",
      "risu/plugins/skills/**/*",
      "node_modules/**/*"
    ],
    "asarUnpack": [
      "toki-mcp-server.js",
      "tiktoken_bg.wasm",
      "glue.wasm",
      "node_modules/node-pty/**/*",
      "node_modules/sharp/**/*",
      "assets/persona/**/*",
      "resources/**/*"
    ],
    "extraResources": [
      {
        "from": "guides",
        "to": "guides"
      },
      {
        "from": "skills",
        "to": "skills"
      },
      {
        "from": "risu",
        "to": "risu",
        "filter": [
          "common/README.md",
          "common/docs/**/*",
          "common/skills/**/*",
          "bot/AGENTS.md",
          "bot/README.md",
          "bot/docs/**/*",
          "bot/skills/**/*",
          "prompts/AGENTS.md",
          "prompts/README.md",
          "prompts/docs/**/*",
          "prompts/skills/**/*",
          "modules/AGENTS.md",
          "modules/README.md",
          "modules/docs/**/*",
          "modules/skills/**/*",
          "plugins/AGENTS.md",
          "plugins/README.md",
          "plugins/docs/**/*",
          "plugins/skills/**/*"
        ]
      }
    ]
  }
}
